<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- Replaces the main switch until permission is granted -->
        <LinearLayout
            android:id="@+id/perm_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/banner_tint"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:paddingStart="?android:attr/listPreferredItemPaddingStart"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_warning"
                android:tint="?android:attr/colorAccent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/perm_role"
                android:textAppearance="?android:attr/textAppearanceListItem" />

            <Button
                android:id="@+id/perm_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/open_settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/main_switch"
            style="@style/SettingRow">

            <TextView
                style="@style/SettingTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/toggle" />

            <Switch
                android:id="@+id/toggle"
                style="@style/SettingSwitch" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/stats_total"
                style="@style/SettingTitle" />

            <TextView
                android:id="@+id/stats_recent"
                style="@style/SettingSummary" />
        </LinearLayout>

        <TextView
            style="@style/SettingHeader"
            android:text="@string/options" />

        <LinearLayout style="@style/SettingRow">

            <LinearLayout style="@style/SettingText">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/notify" />

                <TextView
                    style="@style/SettingSummary"
                    android:text="@string/notify_desc" />
            </LinearLayout>

            <Switch
                android:id="@+id/notify"
                style="@style/SettingSwitch" />
        </LinearLayout>

        <LinearLayout style="@style/SettingRow">

            <LinearLayout style="@style/SettingText">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/instant_decline" />

                <TextView
                    style="@style/SettingSummary"
                    android:text="@string/instant_decline_desc" />
            </LinearLayout>

            <Switch
                android:id="@+id/instant_decline"
                style="@style/SettingSwitch" />
        </LinearLayout>

        <LinearLayout style="@style/SettingRowSingle">

            <TextView
                style="@style/SettingTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/repeat_callers" />

            <Switch
                android:id="@+id/repeat_callers"
                style="@style/SettingSwitch" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/repeat_window"
            style="@style/SettingRow">

            <LinearLayout style="@style/SettingText">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/repeat_window" />

                <TextView
                    android:id="@+id/repeat_window_value"
                    style="@style/SettingSummary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Android 13+ only. Android can't tell us whether the quick setting
            tile is already added -->
        <LinearLayout
            android:id="@+id/add_tile"
            style="@style/SettingRowSingle"
            android:visibility="gone">

            <TextView
                style="@style/SettingTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/add_tile" />
        </LinearLayout>

        <!-- Settings-style footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="?android:attr/listPreferredItemPaddingStart"
            android:paddingTop="24dp"
            android:paddingEnd="?android:attr/listPreferredItemPaddingEnd">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info"
                android:tint="?android:attr/textColorSecondary" />

            <TextView
                style="@style/SettingSummary"
                android:layout_marginTop="16dp"
                android:text="@string/description" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
