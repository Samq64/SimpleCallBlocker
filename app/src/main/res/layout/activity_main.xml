<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- Shown above the disabled main switch until permission is granted -->
        <LinearLayout
            android:id="@+id/perm_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/banner_tint"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:paddingStart="?android:attr/listPreferredItemPaddingStart"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_warning"
                android:tint="?android:attr/colorAccent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/role_banner"
                android:textAppearance="?android:attr/textAppearanceListItem" />

            <Button
                android:id="@+id/perm_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/open_settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/toggle_row"
            style="@style/SettingRow">

            <LinearLayout style="@style/SettingText">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/block_unknown" />

                <TextView
                    android:id="@+id/stats"
                    style="@style/SettingSummary" />
            </LinearLayout>

            <Switch
                android:id="@+id/toggle"
                style="@style/SettingSwitch" />
        </LinearLayout>

        <TextView
            style="@style/SettingHeader"
            android:text="@string/options" />

        <LinearLayout
            android:id="@+id/notify_row"
            style="@style/SettingRow">

            <LinearLayout style="@style/SettingText">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/notify" />

                <TextView
                    style="@style/SettingSummary"
                    android:text="@string/notify_desc" />
            </LinearLayout>

            <Switch
                android:id="@+id/notify"
                style="@style/SettingSwitch" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/instant_decline_row"
            style="@style/SettingRow">

            <LinearLayout style="@style/SettingText">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/instant_decline" />

                <TextView
                    style="@style/SettingSummary"
                    android:text="@string/instant_decline_desc" />
            </LinearLayout>

            <Switch
                android:id="@+id/instant_decline"
                style="@style/SettingSwitch" />
        </LinearLayout>

        <!-- Settings-style split row: the text opens the window picker, the switch toggles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/repeat_window"
                style="@style/SettingRow"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="16dp"
                tools:ignore="RtlSymmetry">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/repeat_callers" />

                <TextView
                    android:id="@+id/repeat_window_value"
                    style="@style/SettingSummary" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:background="?android:attr/listDivider" />

            <FrameLayout
                android:id="@+id/repeat_callers_row"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
                tools:ignore="RtlSymmetry">

                <Switch
                    android:id="@+id/repeat_callers"
                    style="@style/SettingSwitch"
                    android:layout_gravity="center_vertical" />
            </FrameLayout>
        </LinearLayout>

        <!-- Android 13+ only. Android can't tell us whether the quick setting
            tile is already added -->
        <LinearLayout
            android:id="@+id/add_tile"
            style="@style/SettingRow"
            android:visibility="gone">

            <LinearLayout style="@style/SettingText">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/add_tile" />

                <TextView
                    style="@style/SettingSummary"
                    android:text="@string/add_tile_desc" />
            </LinearLayout>
        </LinearLayout>

        <!-- Settings-style footer. A compound drawable would centre the icon, not left-align it. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:ignore="UseCompoundDrawables"
            android:paddingStart="?android:attr/listPreferredItemPaddingStart"
            android:paddingTop="24dp"
            android:paddingEnd="?android:attr/listPreferredItemPaddingEnd">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info"
                android:tint="?android:attr/textColorSecondary" />

            <TextView
                style="@style/SettingSummary"
                android:layout_marginTop="16dp"
                android:text="@string/blocking_info" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
